# ==============================================================================
# AMANA SHIELD — Environment Configuration Template (.env.example)
# Copy this file to .env and replace all placeholder values before running.
# NEVER commit your actual .env file or real credentials to version control.
# ==============================================================================

# Application Settings
APP_NAME="AMANA SHIELD"
APP_ENV="development"
APP_DEBUG="false"
APP_VERSION="0.1.0"
API_V1_PREFIX="/api/v1"
LOG_LEVEL="INFO"
MAX_REQUEST_BODY_BYTES=65536

# Database (PostgreSQL 16 via asyncpg for production / development)
DATABASE_URL="postgresql+asyncpg://amana_user:CHANGE_ME_STRONG_PASSWORD@localhost:5432/amana_shield"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO="false"

# Security & Privacy Secrets (Must be at least 32 characters in production)
SECRET_KEY="CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_RANDOM_64_CHAR_HEX_STRING"
PHONE_HASH_PEPPER="CHANGE_ME_TO_A_UNIQUE_32_BYTE_PEPPER_FOR_SENDER_HASHING"
ANALYST_API_KEY="CHANGE_ME_TO_A_SECURE_ANALYST_API_TOKEN"

# Meta WhatsApp Cloud API Placeholders
WHATSAPP_VERIFY_TOKEN="CHANGE_ME_WEBHOOK_VERIFY_TOKEN"
WHATSAPP_APP_SECRET="CHANGE_ME_META_APP_SECRET"
WHATSAPP_ACCESS_TOKEN="CHANGE_ME_META_GRAPH_API_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="000000000000000"

# AI / LLM Provider Placeholders
LLM_API_KEY="CHANGE_ME_LLM_PROVIDER_API_KEY"
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL_NAME="gpt-4o-mini"
LLM_TIMEOUT_SECONDS=8.0
LLM_MAX_RETRIES=1
LLM_MAX_INPUT_CHARS=4000
LLM_MAX_OUTPUT_TOKENS=900
LLM_RATE_LIMIT_PER_MINUTE=30
