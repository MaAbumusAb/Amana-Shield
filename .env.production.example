# ==============================================================================
# AMANA SHIELD — Production Environment Configuration (.env.production.example)
#
# Instructions:
# 1. Copy this file to .env on your production host:
#      cp .env.production.example .env
# 2. Generate strong 64-character hex secrets:
#      python scripts/generate_secrets.py
# 3. Fill in all CHANGEME placeholders with your actual production secrets.
# 4. Set file permissions:
#      chmod 600 .env
#
# NEVER commit your production .env to GitHub or any version control system.
# ==============================================================================

# Application Runtime Configuration
APP_NAME="AMANA SHIELD"
APP_ENV="production"
APP_DEBUG="false"
APP_VERSION="1.0.0"
API_V1_PREFIX="/api/v1"
LOG_LEVEL="INFO"
MAX_REQUEST_BODY_BYTES=65536
UVICORN_WORKERS=2

# Domain & TLS Configuration (Used by Caddy Reverse Proxy for Automatic HTTPS)
DOMAIN="verify.amanashield.ng"
ACME_EMAIL="ops@amanashield.ng"

# PostgreSQL 16 Database Configuration
POSTGRES_USER="amana_prod_user"
POSTGRES_PASSWORD="CHANGEME_STRONG_POSTGRES_PASSWORD_AT_LEAST_32_CHARS"
POSTGRES_DB="amana_shield_prod"
DATABASE_URL="postgresql+psycopg://amana_prod_user:CHANGEME_STRONG_POSTGRES_PASSWORD_AT_LEAST_32_CHARS@db:5432/amana_shield_prod"
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_ECHO="false"

# Cryptographic & Privacy Secrets (Must be at least 32 characters; generated via scripts/generate_secrets.py)
SECRET_KEY="CHANGEME_RUN_PYTHON_SCRIPTS_GENERATE_SECRETS_64_CHAR_HEX"
PHONE_HASH_PEPPER="CHANGEME_RUN_PYTHON_SCRIPTS_GENERATE_SECRETS_64_CHAR_HEX"
ANALYST_API_KEY="CHANGEME_RUN_PYTHON_SCRIPTS_GENERATE_SECRETS_64_CHAR_HEX"

# Meta WhatsApp Cloud API Production Credentials
# Obtained from Meta Developer Portal -> App Dashboard -> WhatsApp -> API Setup
WHATSAPP_VERIFY_TOKEN="CHANGEME_WEBHOOK_VERIFY_TOKEN_CONFIGURED_IN_META_DASHBOARD"
WHATSAPP_APP_SECRET="CHANGEME_META_APP_SECRET_FROM_APP_SETTINGS_BASIC"
WHATSAPP_ACCESS_TOKEN="CHANGEME_SYSTEM_USER_PERMANENT_GRAPH_API_ACCESS_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="100000000000000"

# AI / LLM Provider Configuration (OpenAI, Azure, or compatible JSON endpoint)
LLM_API_KEY="CHANGEME_OPENAI_OR_AZURE_API_KEY"
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL_NAME="gpt-4o-mini"
LLM_TIMEOUT_SECONDS=8.0
LLM_MAX_RETRIES=1
LLM_MAX_INPUT_CHARS=4000
LLM_MAX_OUTPUT_TOKENS=900
LLM_RATE_LIMIT_PER_MINUTE=60
